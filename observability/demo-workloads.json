{
 "uid": "demo-workloads",
 "title": "Demo workloads",
 "tags": [
  "k8s-agent"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Firing alerts",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ALERTS{alertstate=\"firing\", namespace=\"$namespace\"}",
     "legendFormat": "{{pod}}",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No alerts firing"
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "alertname",
        "pod",
        "deployment",
        "severity",
        "namespace"
       ]
      }
     }
    }
   ]
  },
  {
   "id": 10,
   "title": "Alert history (last 6 hours)",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "timeFrom": "6h",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (alertname, pod, deployment) (ALERTS{alertstate=\"firing\", namespace=\"$namespace\"})",
     "legendFormat": "{{alertname}}: {{pod}}{{deployment}}",
     "interval": "60s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No alerts in the last 6 hours",
     "min": 0,
     "max": 1,
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "firing",
         "color": "red",
         "index": 0
        }
       }
      }
     ],
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 2,
   "title": "Pods by phase",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"$namespace\"} == 1)",
     "legendFormat": "{{phase}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No pods in this namespace"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Waiting reasons (Pending, CrashLoopBackOff, ImagePull...)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kube_pod_container_status_waiting_reason{namespace=\"$namespace\", pod=~\"$pod\"} == 1",
     "legendFormat": "{{pod}}",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No containers are waiting"
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "pod",
        "container",
        "reason",
        "namespace"
       ]
      }
     }
    }
   ]
  },
  {
   "id": 4,
   "title": "Container restarts",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 13,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$pod\"})",
     "legendFormat": "{{pod}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No restarts recorded"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Deployment replicas: desired",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"}",
     "legendFormat": "{{deployment}} desired",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No Deployments in this namespace"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Deployment replicas: available",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 29,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\"}",
     "legendFormat": "{{deployment}} available",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No Deployments in this namespace"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Pods not ready",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 29,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (kube_pod_status_ready{namespace=\"$namespace\", condition=\"false\", pod=~\"$pod\"})",
     "legendFormat": "{{pod}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "No pods are unready"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Pod memory (working set)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\"})",
     "legendFormat": "{{pod}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "noValue": "No pods in this namespace"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Pod CPU (cores)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\"}[5m]))",
     "legendFormat": "{{pod}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "No pods in this namespace"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Logs (selected namespace and pods)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{namespace=\"$namespace\", pod=~\"$pod\"}",
     "queryType": "range",
     "maxLines": 200
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(kube_pod_info, namespace)",
    "refresh": 2,
    "current": {
     "text": "demo",
     "value": "demo"
    },
    "includeAll": false
   },
   {
    "name": "pod",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 }
}