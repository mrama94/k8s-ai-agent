# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local files and editors
.DS_Store
.idea/
.vscode/
*.log
.env
.env.*

# Never commit keys or plain secret manifests. Only SealedSecret files (*.sealedsecret.yaml) belong in git.
# (Patterns are specific on purpose: a broad "secrets/" rule once hid the encrypted files from git.)
*.key
*.pem
*-deploy-key
sealed-secrets-key*.yaml
*.plain.yaml
*.plaintext.yaml

# Scratch output
tmp/
